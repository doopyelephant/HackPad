{
    "manufacturer": "nolan",
    "keyboard_name": "hackpad_with_touchpad",
    "maintainer": "doopyelephant",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "cols": ["GP26", "GP6", "GP7", "GP0"],
        "rows": ["GP3", "GP4", "GP2", "GP1"]
    },
    "processor": "RP2040",
    "url": "https://github.com/doopyelephant/HackPad",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
	  "ps2": {
        "clock_pin": "GP29",
        "data_pin": "GP28",
        "driver": "vendor",
        "enabled": true,
        "mouse_enabled": true
    },
    "layouts": {
        "LAYOUT_numpad_4x4": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0, "h": 2},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},
                {"matrix": [2, 3], "x": 3, "y": 2, "h": 2},
                {"matrix": [3, 0], "x": 0, "y": 3, "w": 2},
                {"matrix": [3, 2], "x": 2, "y": 3}
            ]
        }
    }
}